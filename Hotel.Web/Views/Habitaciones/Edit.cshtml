@model Habitacion
@{
    ViewData["Title"] = "Editar habitación";
}

<h1 class="h3 mb-4">Editar habitación @Model.Numero</h1>

<form asp-action="Edit" method="post" class="col-lg-6">
    <input type="hidden" asp-for="HabitacionId" />
    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
    <partial name="_HabitacionForm" model="Model" />
    <div class="mt-3 d-flex gap-2">
        <button type="submit" class="btn btn-primary">Guardar</button>
        <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
